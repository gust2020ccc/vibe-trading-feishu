# ============================================================
# 飞书 ↔ Vibe-Trading 桥接服务 配置文件
# 复制本文件为 .env 并填入实际值
# ============================================================

# ---------- 飞书自建应用凭据 ----------
# 在 https://open.feishu.cn/app 创建应用后，于「凭证与基础信息」获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Vibe-Trading 调用方式 ----------
# cli  = 通过 subprocess 调用 vibe-trading run -p（默认，最简单）
# api  = 通过 HTTP 调用 Vibe-Trading API Server（需先运行 vibe-trading serve）
VIBE_TRADING_MODE=cli

# API 模式相关（仅 VIBE_TRADING_MODE=api 时生效）
VIBE_TRADING_API_URL=http://localhost:8899
VIBE_TRADING_API_KEY=

# CLI 模式相关
# vibe-trading 命令路径（若不在 PATH 中，填完整路径）
VIBE_TRADING_BIN=vibe-trading
# 可选：指定 Python 解释器（用 python -m vibe_trading 调用），留空则用 VIBE_TRADING_BIN
VIBE_TRADING_PYTHON=

# 单次分析超时（秒），复杂回测可能需要更久
VIBE_TRADING_TIMEOUT=600

# ---------- 消息设置 ----------
# 单条消息最大字符数（超过自动分段）
MAX_TEXT_LENGTH=3500
# 收到指令后的确认回复
ACK_MESSAGE=⏳ 正在分析，请稍候…（复杂回测可能需要数分钟）

# ---------- 访问控制 ----------
# 允许使用的用户 open_id 白名单（逗号分隔，留空=不限制）
# 获取 open_id: 机器人收到消息时日志会打印 sender=open_id
ALLOWED_OPEN_IDS=

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ============================================================
# 以下为 Vibe-Trading 自身配置（写入 ~/.vibe-trading/.env）
# 桥接服务不直接读取，仅供参考
# ============================================================
# LLM 提供商: deepseek / anthropic / openai / siliconflow / zai / kimi 等
# LANGCHAIN_PROVIDER=deepseek
# LANGCHAIN_MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# A股数据源（免费注册 https://tushare.pro）
# TUSHARE_TOKEN=xxxxxxxx
# 研究运行超时
# TIMEOUT_SECONDS=2400
# 非 local 部署的 API 鉴权
# API_AUTH_KEY=
